# Own stage so Dependabot sees the version; it only parses FROM.
FROM ghcr.io/astral-sh/uv:0.12.3@sha256:2d890623d310b57771ce840f0da5eed5fc6d657da05ffaa45d82797b53fa3abc AS uv

# --- Base Stage: Install Dependencies ---
FROM python:{{python_version}}-slim-bookworm AS base

ENV PYTHONUNBUFFERED=True
WORKDIR /app

# Install uv
COPY --from=uv /uv /uvx /bin/

# Copy project definition files for caching
COPY pyproject.toml ./

# Lock and install dependencies using uv
RUN uv lock && uv sync --frozen --no-install-project

# --- Final Stage: Build Application Image ---
FROM python:{{python_version}}-slim-bookworm AS runner

WORKDIR /app

# Copy the virtual environment from the base stage
COPY --from=base /app/.venv ./.venv

# Copy application code
COPY . /app

# Set the entrypoint
CMD ["/app/.venv/bin/python", "/app/src/{{ module_name }}/server.py"]
