{%- set python_version_parts = python_version.split(".") -%}
{%- set python_version_major_minor = python_version_parts[0] ~ python_version_parts[1] -%}
{%- set dev_dependencies = [
    "deptry>=0.0.0",
    "poethepoet>=0.0.0",
    "pyrefly>=0.0.0",
    "pytest>=0.0.0",
    "pytest-xdist>=0.0.0",
    "pytest-cov>=0.0.0",
    "ruff>=0.0.0",
] -%}
{%- if include_precommit -%}
  {%- set dev_dependencies = dev_dependencies + ["complexipy>=0.0.0", "skylos>=0.0.0"] -%}
{%- endif -%}
{%- if use_commitizen -%}
  {%- set dev_dependencies = dev_dependencies + ["commitizen>=0.0.0"] -%}
{%- endif -%}
{%- if include_docs -%}
  {%- set dev_dependencies = dev_dependencies + ["zensical>=0.0.0"] -%}
{%- endif -%}
[project]
name = "{{ module_name }}"
version = "0.1.0"
description = "{{description}}"
readme = "README.md"
authors = [
    { name = "{{ user_full_name | title }}", email = "{{ user_email }}" }
]

# Public libraries should be more lenient
# Internal projects can use a narrower compatible-release specifier.
requires-python = ">={{python_version}}"
dependencies = [
]

[build-system]
# The cap must include the uv that runs the build, otherwise uv can't use its
# own bundled backend and downloads a uv_build wheel from PyPI instead --
# a network fetch at release time that buys nothing.
requires = ["uv_build>=0.8.2,<0.13"]
build-backend = "uv_build"

[dependency-groups]
dev = [
{%- for dependency in dev_dependencies %}
    "{{ dependency }}",
{%- endfor %}
]

[project.scripts]
# running `{{ module_name_slug }}` will run the `{{ module_name }}.hello:main` function
{{ module_name_slug }} = "{{ module_name }}.hello:main"

[tool.poe.tasks]
# setup
{%- if use_commitizen %}
_setup_commitizen = { cmd = "cz init", help = "Initializes Commitizen configuration." }
{% endif -%}

{# This block is purely for variable assignment and should produce no newlines. #}
{%- set setup_dependencies = ["update"] -%}
{%- if use_commitizen -%}
  {%- set setup_dependencies = setup_dependencies + ["_setup_commitizen"] -%}
{%- endif -%}

{#
Only render the 'setup' task if there are actual dependencies for it.
Copier's _tasks already ran git init, uv lock and git add. Git hooks install
themselves on `nix develop`. So this is only dependency updates and commitizen.
#}
{%- if setup_dependencies | length > 0 %}
setup = { cmd = "echo 'Project setup complete!'", deps = {{ setup_dependencies | tojson }}, help = "Performs initial project setup (e.g., initializes commitizen)." }
{%- endif %}

# update
# Hidden update tasks
_update_python_deps = { cmd = "uv sync --upgrade", help = "Updates Python dependencies using uv." }
_update_uv_bump = { cmd = "uvx uv-bump", help = "Updates project version using uv-bump." }
_update_flake = { cmd = "nix flake update", help = "Updates the flake inputs, which pin the dev shell and hook tools." }

{%- set update_sequence = ["_update_flake", "_update_python_deps", "_update_uv_bump"] %}

update = { sequence = {{ update_sequence | tojson }}, help = "Updates the flake inputs, Python dependencies and the project version." }
# run with eg `uv run poe fmt`
fmt = { cmd = "ruff format", help = "Formats Python code using Ruff." }
lint = { cmd = "ruff check --fix", help = "Lints and fixes Python code using Ruff." }
deps = { cmd = "deptry .", help = "Checks dependency declarations with Deptry." }
check = { cmd = "pyrefly check", help = "Performs static type checking with Pyrefly." }
test = { cmd = "pytest", help = "Runs project tests using pytest." }

# Using sequence to ensure they run in order
all = { sequence = ["fmt", "lint", "deps", "check", "test"], help = "Runs all development checks: format, lint, dependency check, type check, and tests." }
clean = { cmd = "uvx pyclean . --debris", help = "Clean up Python cache files and test artifacts using pyclean." }
{% if include_docs %}
serve-docs = { cmd = "zensical serve", help = "Serve documentation locally." }
{% endif %}
"ci:fmt" = { cmd = "ruff format --check", help = "Checks if code is formatted without making changes (for CI)." } # fail if not formatted
"ci:lint" = { cmd = "ruff check", help = "Lints code without applying fixes (for CI)." }
"ci:deps" = { cmd = "deptry .", help = "Checks dependency declarations with Deptry (for CI)." }

[tool.ruff]
# if this is a library, enter the _minimum_ version you
# want to support.
target-version = "py{{ python_version_major_minor }}"
line-length = 80  # use whatever number makes you happy

[tool.ruff.lint]
# you can see the looong list of rules here:
# https://docs.astral.sh/ruff/rules/
# here's a couple to start with
select = [
  "A",    # warn about shadowing built-ins
  "E",    # style stuff, whitespaces
  "F",    # important pyflakes lints
  "I",    # import sorting
  "N",    # naming
  "C90",  # No overly complex nested logic
  "S",    # flake8-bandit security lints (this is why there's no Bandit hook)
  "T100", # breakpoints (probably don't want these in prod!)
]
# if you're feeling confident you can do:
# select = ["ALL"]
# and then manually ignore annoying ones:
# ignore = [...]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"] # pytest is built on bare asserts

[tool.ruff.lint.isort]
# so it knows to group first-party stuff last
known-first-party = ["{{ module_name }}"]

[tool.pyrefly]
python-version = "{{ python_version }}"
search-path = ["src"]

[tool.deptry]
known_first_party = ["{{ module_name }}"]

[tool.pytest.ini_options]
addopts = "--doctest-modules --numprocesses=auto --cov=src/{{ module_name }} --cov-report=term-missing"
testpaths = [
    "tests",
    "src", # so --doctest-modules actually reaches the doctests
]

[tool.tomlsort]
spaces_indent_inline_array = 4
sort_first = [
    "project",
    "build-system",
    "dependency-groups",
    "project.scripts",
]
trailing_comma_inline_array = true
{% if include_docs %}

[tool.uv]
prerelease = "allow"
{% endif %}
